{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Targets Up",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "managed-prometheus"
      },
      "targets": [
        {
          "expr": "sum(up)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Target Availability",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "managed-prometheus"
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Container CPU Usage",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "managed-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) by (namespace, pod)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "managed-prometheus"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{container!=\"\"}) by (namespace, pod)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Application Request Rate",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "managed-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{endpoint!=\"/health\",endpoint!=\"/ready\"}[5m]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "Application Error Rate %",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "managed-prometheus"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{status=~\"5..\",endpoint!=\"/health\",endpoint!=\"/ready\"}[5m])) / clamp_min(sum(rate(http_requests_total{endpoint!=\"/health\",endpoint!=\"/ready\"}[5m])), 0.000001)",
          "legendFormat": "5xx Error Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "Application p95 Latency",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "managed-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{endpoint!=\"/health\",endpoint!=\"/ready\"}[5m])))",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      }
    },
    {
      "type": "timeseries",
      "title": "Application Availability %",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "managed-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - (sum(rate(http_requests_total{status=~\"5..\",endpoint!=\"/health\",endpoint!=\"/ready\"}[5m])) / clamp_min(sum(rate(http_requests_total{endpoint!=\"/health\",endpoint!=\"/ready\"}[5m])), 0.000001)))",
          "legendFormat": "Availability",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "gke",
    "sre",
    "observability",
    "application"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "GKE Observability",
  "uid": "gke-observability",
  "version": 1
}